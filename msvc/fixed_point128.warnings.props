<?xml version="1.0" encoding="utf-8"?>
<!--
  fixed_point128.warnings.props

  The project warning level, imported only by the first party projects. The vendored GoogleTest
  project imports fixed_point128.common.props but not this sheet, because its code is not ours to fix
  and its diagnostics would otherwise be indistinguishable from our own.

  The CMake equivalent is fp128_set_warnings() in cmake/FP128CompilerOptions.cmake.
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <CodeAnalysisRuleSet>NativeRecommendedRules.ruleset</CodeAnalysisRuleSet>
    <EnableMicrosoftCodeAnalysis>true</EnableMicrosoftCodeAnalysis>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <!--
        Angle bracket includes are treated as external headers, so /W4 applies to this project's own
        code and to the library headers (which include each other with quotes) but not to the standard
        library or to GoogleTest. Without this, diagnostics such as C4389 inside gtest.h are reported
        against our projects. This mirrors the SYSTEM include directories CMake already uses.
      -->
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <!--
        4201  float128 stores its 128 bits in an anonymous struct wrapping an anonymous union. The
              layout is the point of the type.
        4702  MSVC reports the code after an `if constexpr` chain as unreachable for the instantiations
              where an earlier branch returns, even though it is live for all the others.
      -->
      <DisableSpecificWarnings>4201;4702;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- /W4 alone leaves most of the Clang specific diagnostics off; -Wextra turns them on. -->
  <ItemDefinitionGroup Condition="'$(PlatformToolset)'=='ClangCL'">
    <ClCompile>
      <AdditionalOptions>-Wextra %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    PREfast is configured but only runs when RunCodeAnalysis is turned on for a build. The tests turn it
    off again, so in practice the analysis warnings below concern the benchmark alone.
  -->
  <ItemDefinitionGroup Condition="'$(PlatformToolset)'!='ClangCL'">
    <ClCompile>
      <EnablePREfast>true</EnablePREfast>
      <!--
        6262  The benchmark lambdas keep BENCH_ARG_COUNT operands on the stack - 16 KB, exactly the
              analyzer's default threshold - so each frame lands a few dozen bytes over it. They run on
              the main thread's 1 MB stack and do not recurse. The array is sized to defeat the branch
              predictor and stays on the stack to keep the timed loops' addressing unchanged; see
              BENCH_ARG_COUNT in bench/Bench.cpp.
        6326  The sign handling in int128_base::operator/= compares two values that are compile time
              constants in the unsigned instantiation. That is the design - the doc comment on the
              operator states that every sign related step folds away when the type is unsigned - and
              the benchmark reaches it because it measures uint128_t.
      -->
      <DisableSpecificWarnings>6262;6326;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
  </ItemDefinitionGroup>

</Project>
