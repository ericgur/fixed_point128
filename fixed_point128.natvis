<?xml version="1.0" encoding="utf-8"?>
<!-- local schema path: C:\Program Files\Microsoft Visual Studio\2022\Professional\Xml\Schemas\1033\natvis.xsd -->
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="fp128::fixed_point128&lt;*&gt;">
    <!--
      The object is a 128-bit two's complement value scaled by 2^-F, with the sign in the MSB
      of 'high'. Every expression below reads the magnitude, which for a negative value is the
      two's complement of the QWORD pair, and the display puts the sign back in front.
      'upper_frac_bits = 63 - I' is the number of fractional bits stored in 'high'.
    -->
    <Intrinsic Name="sign"      Expression="(high &gt;&gt; 63) == 1" />
    <Intrinsic Name="comp_low"  Expression="~low + 1" />
    <Intrinsic Name="comp_high" Expression="(int)(comp_low() == 0) + ~high" />
    <Intrinsic Name="mag_low"   Expression="sign() ? comp_low() : low" />
    <Intrinsic Name="mag_high"  Expression="sign() ? comp_high() : high" />
    <!--
      Exact integer part of the magnitude via integer bit-shift.
      Avoids the precision loss that occurs when the full 64-bit 'high' is cast to double
      before scaling: double has only a 53-bit mantissa, so casting a large 64-bit value
      discards the lower 11 bits before the multiplication happens.
    -->
    <Intrinsic Name="int_part" Expression="(uint64_t)(mag_high() &gt;&gt; upper_frac_bits)" />
    <!--
      Fractional contribution from the upper QWORD, split into two 32-bit halves.
      Each half has at most 32 significant bits, which fits exactly into a double mantissa
      (53 bits), giving lossless conversion for all valid template parameters including
      the extreme case I=1 where upper_frac_bits=62 (> 53, so a direct cast would lose bits).
    -->
    <Intrinsic Name="high_frac_h" Expression="(double)(((mag_high() &amp; ((1ULL &lt;&lt; upper_frac_bits) - 1)) &gt;&gt; 32) &amp; 0xFFFFFFFF) * (upper_unity * 4294967296.0)" />
    <Intrinsic Name="high_frac_l" Expression="(double)((mag_high() &amp; ((1ULL &lt;&lt; upper_frac_bits) - 1)) &amp; 0xFFFFFFFF) * upper_unity" />
    <!--
      Fractional contribution from the lower QWORD, split into two 32-bit halves.
      Each half fits exactly in a double mantissa.
    -->
    <Intrinsic Name="low_frac_h"   Expression="(double)(mag_low() &gt;&gt; 32) * lower_unity_h" />
    <Intrinsic Name="low_frac_l"   Expression="(double)(mag_low() &amp; 0xFFFFFFFF) * lower_unity_l" />
    <!--
      Combined fractional value as a double.
      Reading all four 32-bit chunks together covers the full 127-bit fractional range,
      but when summed here the result is limited to ~15 significant decimal digits.
    -->
    <Intrinsic Name="frac_value"   Expression="high_frac_h() + high_frac_l() + low_frac_h() + low_frac_l()" />
    <!-- Backward-compatible alias for the lower-QWORD fraction. -->
    <Intrinsic Name="low_fraction" Expression="low_frac_h() + low_frac_l()" />

    <!--
      DisplayString conditions:
        - When int_part fits in a double mantissa (< 2^53 = 9007199254740992): display as a
          single combined double — integer and fraction merge without precision loss.
        - When int_part exceeds double precision (>= 2^53): display the integer and fractional
          parts separately so the fractional component is not silently swallowed by the large
          integer (this occurs for I >= 54 with large values).
    -->
    <DisplayString Condition="!sign() &amp;&amp; int_part() &lt;= 9007199254740992ULL">{(double)int_part() + frac_value()}</DisplayString>
    <DisplayString Condition="sign() &amp;&amp; int_part() &lt;= 9007199254740992ULL">-{(double)int_part() + frac_value()}</DisplayString>
    <DisplayString Condition="!sign()">{int_part(),u} + {frac_value()}</DisplayString>
    <DisplayString Condition="sign()">-{int_part(),u} - {frac_value()}</DisplayString>

    <Expand HideRawView="true">
      <!--
        Quick combined double approximation (sign × (integer + fraction)).
        Useful for a single-glance value. Limited to ~15 significant decimal digits.
      -->
      <Item Name="[double approx]"    ExcludeView="simple">((sign()) ? -1.0 : 1.0) * ((double)int_part() + frac_value())</Item>
      <!--
        Exact integer component of the magnitude, extracted via integer bit-shift.
        Precise for all valid I values including I=63 where the integer can reach 2^63,
        which cannot be represented exactly in a double.
      -->
      <Item Name="[integer (exact)]"  ExcludeView="simple">int_part(), u</Item>
      <!--
        Fractional contributions broken into four independent 32-bit precision chunks.
        Together these four values cover the full 127-bit fractional precision of the type.
        high frac msb + high frac lsb accounts for the (63-I) fractional bits in 'high'.
        low  frac msb + low  frac lsb accounts for all 64 fractional bits in 'low'.
      -->
      <Item Name="[high frac (msb)]"  ExcludeView="simple">high_frac_h()</Item>
      <Item Name="[high frac (lsb)]"  ExcludeView="simple">high_frac_l()</Item>
      <Item Name="[low frac (msb)]"   ExcludeView="simple">low_frac_h()</Item>
      <Item Name="[low frac (lsb)]"   ExcludeView="simple">low_frac_l()</Item>
      <!-- Raw fields for bit-level inspection. -->
      <Item Name="[negative]"         ExcludeView="simple">sign()</Item>
      <Item Name="[low (hex)]"        ExcludeView="simple">low, h</Item>
      <Item Name="[high (hex)]"       ExcludeView="simple">high, h</Item>
      <Item Name="[low]"              ExcludeView="simple">low, d</Item>
      <Item Name="[high]"             ExcludeView="simple">high, d</Item>
    </Expand>
  </Type>
  <!--
    uint128_t and int128_t are both aliases of fp128::int128_base<IsSigned>, so a single wildcard
    entry covers them. $T1 substitutes the template argument exactly as the type name spells it,
    which is 0 or 1 for MSVC; comparing against zero rather than a literal keeps this working if a
    toolchain spells it false/true instead.
  -->
  <Type Name="fp128::int128_base&lt;*&gt;">
    <Intrinsic Name="is_signed" Expression="$T1 != 0" />
    <!-- the unsigned instantiation never takes the negative display path -->
    <Intrinsic Name="sign" Expression="is_signed() &amp;&amp; (high >> 63) == 1" />
    <Intrinsic Name="sign_int" Expression="(sign()) ? -1 : 1" />
    <Intrinsic Name="comp_low" Expression="~low + 1" />
    <Intrinsic Name="comp_high" Expression="(int)(comp_low() == 0) + ~high" />
    <DisplayString Condition="sign()">-{comp_high(),h}{comp_low(),hb}</DisplayString>
    <DisplayString>{high,h}{low,hb}</DisplayString>
    <Expand HideRawView="true" >
      <Item Name="[signed]"    ExcludeView="simple">is_signed()</Item>
      <Item Name="[low (hex)]"  ExcludeView="simple">low,h</Item>
      <Item Name="[high (hex)]" ExcludeView="simple">high,h</Item>
      <Item Name="[low]"  ExcludeView="simple">low,d</Item>
      <Item Name="[high]" ExcludeView="simple">high,d</Item>
      <!-- <Item Name="[Value]" ExcludeView="simple">this-&gt;to_string()</Item> -->
    </Expand>
  </Type>
  <Type Name="fp128::float128">
    <Intrinsic Name="special" Expression="high_bits.e == 0x7FFF" />
    <Intrinsic Name="has_fraction" Expression="high_bits.f != 0 || low != 0" />
    <Intrinsic Name="inf" Expression="special() &amp;&amp; !has_fraction()" />
    <Intrinsic Name="nan" Expression="special() &amp;&amp; has_fraction()" />
    <Intrinsic Name="sign" Expression="high_bits.s" />
    <Intrinsic Name="sign_float" Expression="(sign()) ? -1.0 : 1.0" />
    <Intrinsic Name="exp" Expression="(int)high_bits.e - (int)0x3FFF" />
    <Intrinsic Name="exp_inc" Expression="(exp() &lt; 0 ) ? -1 : 1" />
    <Intrinsic Name="low_fraction" Expression="(double)(low &gt;&gt; 32) * 8.271806125530277e-25 + (double)(low &amp; 0xFFFFFFFF) * 1.925929944387236e-34" />
    <Intrinsic Name="fraction" Expression="1.0 + (double)high_bits.f * 3.552713678800501e-15 + low_fraction()" />
    <Intrinsic Name="zero" Expression="low == 0 &amp;&amp; high == 0" />
    <Intrinsic Name="neg_zero" Expression="low == 0 &amp;&amp; high_bits.f == 0  &amp;&amp; high_bits.e == 0 &amp;&amp; high_bits.s == 1" />
    <DisplayString Condition="nan() &amp;&amp; !sign()">nan</DisplayString>
    <DisplayString Condition="nan() &amp;&amp; sign()">-nan</DisplayString>
    <DisplayString Condition="inf() &amp;&amp; !sign()">inf</DisplayString>
    <DisplayString Condition="inf() &amp;&amp; sign()">-inf</DisplayString>
    <DisplayString Condition="zero()">0</DisplayString>
    <DisplayString Condition="neg_zero()">-0</DisplayString>
    <DisplayString>{sign_float() * fraction()}*2**{(int)high_bits.e - (int)0x3FFF,d}</DisplayString>
    <Expand HideRawView="false" >
      <CustomListItems MaxItemsPerView="1" ExcludeView="Test">
        <Variable Name="exp_value" InitialValue="exp()" />
        <Variable Name="res" InitialValue="fraction() * sign_float()" />
        <!--  loop and mul/div the fraction by 2 until the exponent is zero. res has the final result -->
        <Loop>
          <If Condition="exp_value &gt; 0">
            <Exec>exp_value--</Exec>
            <Exec>res *= 2.0</Exec>
          </If>
          <If Condition="exp_value &lt; 0">
            <Exec>exp_value++</Exec>
            <Exec>res /= 2.0</Exec>
          </If>
          <Break Condition="exp_value == 0" />
        </Loop>
        <Item Name="[double value]" Condition="!special()">res,d</Item>
        <Item Name="[double value]" Condition="nan() &amp;&amp; !sign()">"nan", sb</Item>
        <Item Name="[double value]" Condition="nan() &amp;&amp; sign()">"-nan", sb</Item>
        <Item Name="[double value]" Condition="inf() &amp;&amp; !sign()">"inf", sb</Item>
        <Item Name="[double value]" Condition="inf() &amp;&amp; sign()">"-inf", sb</Item>
      </CustomListItems>
      <Item Name="[sign]"            ExcludeView="simple">high_bits.s,d</Item>
      <Item Name="[exponent (hex)]"  ExcludeView="simple">high_bits.e,h</Item>
      <Item Name="[frac high (hex)]" ExcludeView="simple">high_bits.f,h</Item>
      <Item Name="[frac low (hex)]"  ExcludeView="simple">low,h</Item>
      <Item Name="[exponent]"  ExcludeView="simple">exp(),d</Item>
      <Item Name="[frac high]" ExcludeView="simple">high_bits.f,d</Item>
      <Item Name="[frac low]"  ExcludeView="simple">low,d</Item>
    </Expand>
  </Type>
</AutoVisualizer>
