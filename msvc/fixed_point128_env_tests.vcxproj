<?xml version="1.0" encoding="utf-8"?>
<!--
  fixed_point128_env_tests.vcxproj

  The tests of float128's opt in floating point environment, built through MSBuild with
  FP128_IEEE_ENV defined. The macro changes the definitions of inline functions, so these cannot be
  linked into the program fixed_point128_tests.vcxproj builds and are a program of their own. The
  CMake equivalent is the fixed_point128_env_tests target in tests/CMakeLists.txt.

  Set this as the solution startup project to run the tests under the debugger. The ProjectReference
  to googletest.vcxproj builds and links the static library automatically, and the natvis item below
  is compiled into the PDB so the library types pretty-print in Locals and Watch.

  Visual Studio's Test Explorer discovers the individual cases through the "Test Adapter for Google
  Test" component, which allows debugging a single test without touching the command line arguments.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug_clang|x64">
      <Configuration>Debug_clang</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release_clang|x64">
      <Configuration>Release_clang</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{8f0e3c1a-5b2d-4e7f-9a61-3d4c2b1e0f75}</ProjectGuid>
    <RootNamespace>fixedpoint128envtests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug_clang|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>ClangCL</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release_clang|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>ClangCL</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="fixed_point128.common.props" />
    <Import Project="fixed_point128.warnings.props" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <!-- Run from the output directory so a debugged test resolves relative paths the way ctest does. -->
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(FP128Root)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!--
        Static analysis is turned off for the tests. The GoogleTest assertion macros expand to
        comparisons the analyzer reports as constant-versus-constant (C6326) thousands of times over,
        which is inherent to how the macros work rather than a defect in the tests.
      -->
      <EnablePREfast>false</EnablePREfast>
      <!--
        The string round-trip tests copy between fixed size buffers they own with strcpy/strlen, which
        the Windows CRT marks deprecated in favour of its non-portable _s variants.
      -->
      <PreprocessorDefinitions>FP128_IEEE_ENV=1;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!--
    Where the GoogleTest headers come from, and how each toolset is told to stop warning about them.

    MSVC honours /external:anglebrackets (set in fixed_point128.warnings.props), so a plain include
    directory is enough. clang-cl does not implement that switch and needs the directory to be named
    as a system include instead, which is what -imsvc does. The path is therefore added exactly once,
    through whichever mechanism the active toolset understands.
  -->
  <ItemDefinitionGroup Condition="'$(PlatformToolset)'!='ClangCL'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(FP128GoogleTestDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(PlatformToolset)'=='ClangCL'">
    <ClCompile>
      <AdditionalOptions>-imsvc "$(FP128GoogleTestDir)include" %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(FP128Root)tests\float128_env_gtest.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(FP128Root)tests\gtest_shared.h" />
    <ClInclude Include="$(FP128Root)tests\float128_ref_check.h" />
    <ClInclude Include="$(FP128Root)tests\float128_ref_data.h" />
  </ItemGroup>
  <ItemGroup>
    <Natvis Include="$(FP128Root)fixed_point128.natvis" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="googletest.vcxproj">
      <Project>{2c43c518-cd01-49ee-8385-1e85a0da3e97}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
