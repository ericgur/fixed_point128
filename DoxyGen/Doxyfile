# Doxyfile for the fixed_point128 library.
#
# Run from the REPOSITORY ROOT, not from this directory:
#
#     doxygen DoxyGen/Doxyfile
#
# Output lands in DoxyGen/html (git-ignored). The GitHub Actions workflow
# .github/workflows/docs.yml runs exactly this command and publishes the result to
# https://ericgur.github.io/fixed_point128/
#
# Only settings that differ from the doxygen defaults are listed. Run `doxygen -x DoxyGen/Doxyfile`
# to see this file expanded against the defaults of the installed doxygen, or `doxygen -u` to
# upgrade it to a newer doxygen release.
#
# The version number is taken from the FP128_DOC_VERSION environment variable, which the workflow
# derives from the FP128_VERSION_* macros in include/fp128_shared.h. It is empty for a local run,
# which only means the header of every page carries no version string.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = fixed_point128
PROJECT_NUMBER         = $(FP128_DOC_VERSION)
PROJECT_BRIEF          = "128 bit integer, fixed point and floating point arithmetic for C++20"

OUTPUT_DIRECTORY       = DoxyGen
HTML_OUTPUT            = html
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
# README.md is listed first so that it becomes the landing page of the generated site.
INPUT                  = README.md \
                         include
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h \
                         *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md

# LICENSE is not documented, it is copied verbatim so that the link at the bottom of the
# landing page resolves on the generated site the same way it does on GitHub.
HTML_EXTRA_FILES       = LICENSE

#---------------------------------------------------------------------------
# What to document
#---------------------------------------------------------------------------
# The library is header only and every entity a user can reach lives in a header, so everything
# is extracted. Private members are the implementation of that public surface and are left out.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO

# Group the free functions and constants of namespace fp128 onto the namespace page rather than
# scattering them across the file pages.
SHOW_NAMESPACES        = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES

BUILTIN_STL_SUPPORT    = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include
FULL_PATH_NAMES        = YES

#---------------------------------------------------------------------------
# Preprocessing
#---------------------------------------------------------------------------
# Without this, doxygen reads `class FP128_ALIGN16 float128` as a class named FP128_ALIGN16 and
# carries the calling convention and inlining macros into every signature it prints. Expanding
# only the macros listed below keeps the published signatures identical to the source.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SKIP_FUNCTION_MACROS   = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = include
PREDEFINED             = FP128_ALIGN16= \
                         "FP128_ALIGN(a)=" \
                         FP128_INLINE=inline \
                         FP128_FORCE_INLINE=inline \
                         FP128_NO_INLINE= \
                         FP128_THROW_ONLY_IN_DEBUG=noexcept \
                         "FP128_ASSERT(x)="

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
DISABLE_INDEX          = NO
HTML_COLORSTYLE        = TOGGLE
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100
GENERATE_TODOLIST      = YES
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

# The implementation is the documentation for a header only library: cross reference every
# declaration with its source, and keep the comments in the listing.
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
VERBATIM_HEADERS       = YES

# Class hierarchies are rendered as text. Graphviz is not required to build the documentation.
HAVE_DOT               = NO

#---------------------------------------------------------------------------
# Other output formats
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

#---------------------------------------------------------------------------
# Diagnostics
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
# The headers currently document themselves without a single warning, so a warning means something
# broke. FAIL_ON_WARNINGS_PRINT reports them all before returning a non-zero exit code, which fails
# the documentation workflow rather than quietly publishing a page with a mangled signature on it.
WARN_AS_ERROR          = FAIL_ON_WARNINGS_PRINT
